int pixel = 0;
int scroll_counterx = 0;
int text_size = 0;
int blink_counter = 0;
int movepixel = 0;
int contrast = 0;


void setup() {

  if (!display.begin(SSD1306_SWITCHCAPVCC, I2C_Address)) { //Use internal 7.5V VCC for pixels, at the address
    while (true); // Stop if display isn't found
  }

  // Display Adafruit splash screen
  display.display();
  delay(3000);

  display.clearDisplay();
}

void loop() {
  //Show some text
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);

  display.setCursor(0, 0);
  display.println("OLED");
  display.println("Screen");
  display.println("Functions");
  display.print("Demo");

  display.display();
  delay(3000);

  display.clearDisplay();

  //More text
  display.setCursor(13, 8);
  display.print("0.91 Inch, 128x32");
  display.setCursor(52, 18);
  display.print("OLED");

  display.invertDisplay(true);
  display.display();
  delay(3000);

  display.invertDisplay(false);
  display.clearDisplay();

  //Rectangle
  display.drawRect(10, 2, 108, 28, SSD1306_WHITE); //X, Y, WIDTH, HEIGHT, COLOR
  display.display();
  delay(1000);

  display.fillRect(10, 2, 108, 28, SSD1306_WHITE);
  display.display();
  delay(1000);

  display.clearDisplay();

  //Circle
  display.drawCircle(64, 16, 14, SSD1306_WHITE); //X, Y, RADIUS, COLOR
  display.display();
  delay(1000);

  display.fillCircle(64, 16, 14, SSD1306_WHITE);
  display.display();
  delay(1000);

  display.clearDisplay();

  //Triangle
  display.drawTriangle(64, 2, 5, 29, 123, 29, SSD1306_WHITE); //POINT A (X,Y), POINT B (X,Y), POINT C (X,Y), COLOR
  display.display();
  delay(1000);

  display.fillTriangle(64, 2, 5, 29, 123, 29, SSD1306_WHITE);
  display.display();
  delay(1000);

  display.clearDisplay();

  //Rounded corners rectangle
  display.drawRoundRect(10, 2, 108, 28, 8, SSD1306_WHITE); //X, Y, WIDTH, HEIGHT, CORNER RADIUS
  display.display();
  delay(1000);

  display.fillRoundRect(10, 2, 108, 28, 8, SSD1306_WHITE);
  display.display();
  delay(1000);

  display.clearDisplay();


  //Randomly light up pixels on screen
  for (pixel = 0; pixel <= 500; pixel++) {

    display.drawPixel(random(0, SCREEN_WIDTH), random(0, SCREEN_HEIGHT), SSD1306_WHITE);
    display.display();
    delay(2);
  }

  display.clearDisplay();

  //Display custon 128x32 monochrome picture bitmap
  display.drawBitmap(0, 0, image, 128, 32, SSD1306_WHITE); //X, Y, defined bitmap, width, height, color
  display.display();
  delay(500);

  // Invert display a few times
  display.invertDisplay(true);
  delay(500);
  display.invertDisplay(false);
  delay(500);
  display.invertDisplay(true);
  delay(500);
  display.invertDisplay(false);
  delay(500);

  display.clearDisplay();


  //Change text size
  for (text_size = 0; text_size <= 8; text_size++) {

    display.clearDisplay();
    display.setTextSize(text_size);
    display.setCursor(0, 0);
    display.println("Text");
    display.print("Sizes");
    display.display();
    delay(500);
  }

  for (text_size = 8; text_size >= 0; text_size--) {

    display.clearDisplay();
    display.setTextSize(text_size);
    display.setCursor(0, 0);
    display.println("Text");
    display.print("Sizes");
    display.display();
    delay(500);
  }

  delay(500);
  display.clearDisplay();


  //Scrolling text
  display.setCursor(36 + scroll_counterx, 5);
  display.print("Scrolling");
  display.setCursor(52 + scroll_counterx, 15);
  display.print("Text");
  display.display();
  delay(500);


  // Scroll left
  for (scroll_counterx = 0; scroll_counterx <= 35; scroll_counterx++) {
    display.clearDisplay();

    display.setCursor(36 + scroll_counterx, 5);
    display.print("Scrolling");
    display.setCursor(52 + scroll_counterx, 15);
    display.print("Text");

    display.display();
    delay(5);
  }
  delay(500);

  // Scroll right
  for (scroll_counterx = 35; scroll_counterx >= -35; scroll_counterx--) {
    display.clearDisplay();

    display.setCursor(36 + scroll_counterx, 5);
    display.print("Scrolling");
    display.setCursor(52 + scroll_counterx, 15);
    display.print("Text");

    display.display();
    delay(5);
  }
  delay(500);

  // Return to middle
  for (scroll_counterx = -35; scroll_counterx <= 0; scroll_counterx++) {
    display.clearDisplay();

    display.setCursor(36 + scroll_counterx, 5);
    display.print("Scrolling");
    display.setCursor(52 + scroll_counterx, 15);
    display.print("Text");

    display.display();
    delay(5);
  }
  delay(500);
  display.clearDisplay();


  //Blinking text

  for (blink_counter = 0; blink_counter <= 5; blink_counter++) {
    display.clearDisplay();
    display.setTextColor(SSD1306_WHITE);

    display.setCursor(40, 5);
    display.print("Blinking");
    display.setCursor(48, 17);
    display.print("Text!");

    display.display();
    delay(300);

    display.clearDisplay();
    display.setTextColor(SSD1306_BLACK);

    display.setCursor(40, 5);
    display.print("Blinking");
    display.setCursor(48, 17);
    display.print("Text!");

    display.display();
    delay(300);
  }

  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);


  //Fill display with text
  display.setCursor(0, 0);
  display.println("0.91 inch OLED");
  display.println("Monochrome display");
  display.println("128 x 32 pixels");
  display.println("I2C Controlled");

  display.display();
  delay(10000);

  display.clearDisplay();


  //Make pixels move around inside a border
  display.drawRect(10, 2, 108, 28, SSD1306_WHITE);
  display.display();
  delay(1000);

  for (movepixel = 0; movepixel <= 30; movepixel++) {

    display.clearDisplay();

    // Keep random pixels inside the border
    display.drawPixel(random(11, 117), random(3, 29), SSD1306_WHITE);

    display.drawRect(10, 2, 108, 28, SSD1306_WHITE);
    display.display();
    delay(200);
  }

  display.clearDisplay();
 

  //Ramp up and down brightness
  display.setCursor(38, 12);
  display.print("Brightness");
  display.invertDisplay(true);
  display.display();

  // Fade down (SSD1306 OLED Displays need the raw command sent to them, unlike SH1106 displays)
  for (contrast = 255; contrast >= 0; contrast--) {
    display.ssd1306_command(SSD1306_SETCONTRAST);
    display.ssd1306_command(contrast);
    delay(5);
  }
  delay(1000);

  // Fade up
  for (contrast = 0; contrast <= 255; contrast++) {
    display.ssd1306_command(SSD1306_SETCONTRAST);
    display.ssd1306_command(contrast);
    delay(5);
  }
  delay(1000);

  //Put all the way down
  display.ssd1306_command(SSD1306_SETCONTRAST);
  display.ssd1306_command(0x00);
  delay(1000);

  //Put all the way up
  display.ssd1306_command(SSD1306_SETCONTRAST);
  display.ssd1306_command(0xFF);
  delay(1000);

  display.clearDisplay();
  display.invertDisplay(false);
  display.display();
  delay(1000);
}